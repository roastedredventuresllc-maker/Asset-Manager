# LaunchPad environment — NAMES only, no secrets, no values.
# Copy to .env and fill from your secret store. Never commit .env.
# The API loads repo-root .env on boot if present (does not override existing env).

DATABASE_URL=
PORT=
BASE_PATH=
ADS_MODE=mock
ADMIN_PASSWORD=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Anthropic (these are the names the integration reads on this repo)
AI_INTEGRATIONS_ANTHROPIC_API_KEY=
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=

# Images — do not call gemini-3-pro-image-preview until CEO approves spend
GEMINI_API_KEY=
AI_INTEGRATIONS_GEMINI_API_KEY=
AI_INTEGRATIONS_GEMINI_BASE_URL=
OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# Optional product-photo background removal
FAL_API_KEY=

# Local split: API listen port if PORT is used by Vite
API_PORT=
VITE_DEV_PORT=
PUBLIC_APP_URL=

# Meta — META_BUSINESS_ID is Ad Account ID (digits only), not Business Manager ID
META_SYSTEM_USER_TOKEN=
META_BUSINESS_ID=
META_DEFAULT_PAGE_ID=

# TikTok
TIKTOK_ACCESS_TOKEN=
TIKTOK_BC_ID=
TIKTOK_ADVERTISER_ID=
TIKTOK_IDENTITY_ID=

# Google Ads (v1)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

WORKER_SECRET=
