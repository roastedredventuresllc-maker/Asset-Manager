# LaunchPad local/dev environment
# Copy to .env and fill values in your secret store — never commit this file with secrets.

# Required to boot the API + frontend
PORT=8080
# Frontend (Vite) uses PORT=5173 BASE_PATH=/ when run separately
DATABASE_URL=postgres://launchpad:launchpad@localhost:5432/launchpad

# Ads stay in mock. Saving connector credentials must NEVER change this.
ADS_MODE=mock

# Admin Connectors UI + encrypted credential storage
ADMIN_PASSWORD=

# Campaign copy (Claude). Off-Replit names:
ANTHROPIC_API_KEY=
# Replit AI Integrations aliases (optional):
# AI_INTEGRATIONS_ANTHROPIC_API_KEY=
# AI_INTEGRATIONS_ANTHROPIC_BASE_URL=

# Image quality path is gemini-3-pro-image-preview (CEO must approve spend before calling it).
# Off-Replit:
GEMINI_API_KEY=
# Replit aliases:
# AI_INTEGRATIONS_GEMINI_API_KEY=
# AI_INTEGRATIONS_GEMINI_BASE_URL=
# Fallback image model:
OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_BASE_URL=

# Optional product-photo background removal
# FAL_API_KEY=
# FAL_KEY=

# Stripe (checkout). Test mode is fine.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional public hostname for asset/magic-link URLs
# PUBLIC_APP_URL=http://localhost:8080

# Meta (Ad Account ID goes in META_BUSINESS_ID — digits only, not Business Manager ID)
# META_SYSTEM_USER_TOKEN=
# META_BUSINESS_ID=
# META_DEFAULT_PAGE_ID=

# TikTok
# TIKTOK_ACCESS_TOKEN=
# TIKTOK_BC_ID=
# TIKTOK_ADVERTISER_ID=
# TIKTOK_IDENTITY_ID=

# Google Ads (v1 channel)
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Optional worker cron header
# WORKER_SECRET=
