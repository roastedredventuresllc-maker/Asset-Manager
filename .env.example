# LaunchPad environment — NAMES only, no secrets, no values.
# Copy to .env and fill from your secret store. Never commit .env.
# On Vercel, set these in Project Settings → Environment Variables.
# The API loads repo-root .env on boot if present (does not override existing env).

DATABASE_URL=
PORT=
BASE_PATH=
ADS_MODE=mock
ADMIN_PASSWORD=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Grok via Vercel AI Gateway (preferred on Vercel). OIDC is injected on deploy.
# Local: `vercel env pull .env.local` or set AI_GATEWAY_API_KEY.
# Fallback if Gateway is unavailable: XAI_API_KEY from Vercel env (never commit).
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=
XAI_API_KEY=
XAI_BASE_URL=
XAI_MODEL=

# Anthropic (optional — reference-image vision only; not required to generate)
AI_INTEGRATIONS_ANTHROPIC_API_KEY=
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=

# Images — do not call gemini-3-pro-image-preview until CEO approves spend
GEMINI_API_KEY=
AI_INTEGRATIONS_GEMINI_API_KEY=
AI_INTEGRATIONS_GEMINI_BASE_URL=
OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# Optional product-photo background removal
FAL_API_KEY=

# Vercel Blob — required on Vercel for durable ad images (empty here; set in Vercel env).
# /tmp does not survive across invocations. Never commit the token.
BLOB_READ_WRITE_TOKEN=

# Local split: API listen port if PORT is used by Vite
API_PORT=
VITE_DEV_PORT=
PUBLIC_APP_URL=

# Cron / worker (Vercel Cron sends Authorization: Bearer CRON_SECRET)
WORKER_SECRET=
CRON_SECRET=

# Meta — META_BUSINESS_ID is LaunchPad's house/test Ad Account ID (digits only, no act_ prefix), not Business Manager ID. Client brands use per-customer IDs.
META_SYSTEM_USER_TOKEN=
META_BUSINESS_ID=
META_DEFAULT_PAGE_ID=

# TikTok — house/test advertiser. TIKTOK_IDENTITY_ID is a CUSTOMIZED_USER identity (required for image ads). Client advertisers are stored per customer.
TIKTOK_ACCESS_TOKEN=
TIKTOK_BC_ID=
TIKTOK_ADVERTISER_ID=
TIKTOK_IDENTITY_ID=

# Google Ads (v1) — GOOGLE_ADS_CUSTOMER_ID is the house/test customer; GOOGLE_ADS_LOGIN_CUSTOMER_ID is the MCC used for every client.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
