# LaunchPad local/dev environment
# Copy to .env and fill values in your secret store — never commit this file with secrets.
# Names match CODE. The API loads this file on boot if present (does not override
# variables already set). Vite reads it from the repo root (envDir).

# API listen port. (Replit sets PORT on the frontend; locally we use API_PORT
# so Vite can stay on 5173.)
API_PORT=8080
# Vite: VITE_DEV_PORT=5173 BASE_PATH=/
DATABASE_URL=postgres://launchpad:launchpad@localhost:5432/launchpad

# Ads stay in mock. Saving connector credentials must NEVER change this.
ADS_MODE=mock

# Required for /admin login and encrypted connector storage. Login returns 503 without it.
ADMIN_PASSWORD=

# Browser-facing origin (Stripe success URL, magic links). Local default
# without this is http://127.0.0.1:5173 (Vite). Set explicitly if you want:
PUBLIC_APP_URL=http://localhost:5173

# Campaign copy (Claude). Off-Replit name:
ANTHROPIC_API_KEY=
# Replit AI Integrations aliases (optional):
# AI_INTEGRATIONS_ANTHROPIC_API_KEY=
# AI_INTEGRATIONS_ANTHROPIC_BASE_URL=

# Image quality path is gemini-3-pro-image-preview (CEO must approve spend before calling it).
GEMINI_API_KEY=
# AI_INTEGRATIONS_GEMINI_API_KEY=
# AI_INTEGRATIONS_GEMINI_BASE_URL=
OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_BASE_URL=

# Optional product-photo background removal
# FAL_API_KEY=
# FAL_KEY=

# Stripe test mode
STRIPE_SECRET_KEY=
# Forward events locally: stripe listen --forward-to localhost:8080/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# Meta (Ad Account ID goes in META_BUSINESS_ID — digits only, not Business Manager ID)
# META_SYSTEM_USER_TOKEN=
# META_BUSINESS_ID=
# META_DEFAULT_PAGE_ID=

# TikTok
# TIKTOK_ACCESS_TOKEN=
# TIKTOK_BC_ID=
# TIKTOK_ADVERTISER_ID=
# TIKTOK_IDENTITY_ID=

# Google Ads (v1 channel)
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Optional worker cron header
# WORKER_SECRET=
